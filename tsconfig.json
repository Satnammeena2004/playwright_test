{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "@playwright/test"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
     "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["tests/**/*.ts", "playwright.config.ts", "global-setup.ts", "tests/**/*.spec.ts"]
}